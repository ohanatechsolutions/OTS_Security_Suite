{
  "manifest_version": 3,
  "name": "OTS GitHub Malware Scanner — Local",
  "version": "2.4.0",
  "description": "Open the locally installed Ohana Tech Solutions scanner for the current GitHub or Bitbucket repository.",
  "action": {"default_title": "OTS GitHub Malware Scanner", "default_popup": "popup.html", "default_icon": {"16":"icons/icon16.png", "32":"icons/icon32.png"}},
  "icons": {"16":"icons/icon16.png", "32":"icons/icon32.png", "48":"icons/icon48.png", "128":"icons/icon128.png"},
  "permissions": ["activeTab","tabs"]
}
