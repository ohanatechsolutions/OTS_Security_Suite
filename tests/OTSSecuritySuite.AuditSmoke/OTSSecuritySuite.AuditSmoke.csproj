<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Exercise the exact production runner without starting WPF or bringing in a test framework. -->
    <Compile Include="../../src/OTSSecuritySuite.Desktop/WhiteAuditRunner.cs" Link="WhiteAuditRunner.cs" />
    <Compile Include="../../src/OTSSecuritySuite.Desktop/ProtocolActivation.cs" Link="ProtocolActivation.cs" />
    <Compile Include="../../src/OTSSecuritySuite.Desktop/WhiteReportWriter.cs" Link="WhiteReportWriter.cs" />
    <Compile Include="../../src/OTSSecuritySuite.Desktop/QuarantineVaultRegistry.cs" Link="QuarantineVaultRegistry.cs" />
    <ProjectReference Include="../../modules/OTS_System_Sanitizer/src/OTSSystemSanitizer.Core/OTSSystemSanitizer.Core.csproj" />
  </ItemGroup>
</Project>
