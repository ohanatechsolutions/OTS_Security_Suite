<Application x:Class="OTSSecuritySuite.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Neon" Color="#39FF14" />
    <SolidColorBrush x:Key="Background" Color="#080D09" />
    <SolidColorBrush x:Key="Panel" Color="#142019" />
    <SolidColorBrush x:Key="BorderColor" Color="#35543C" />
    <Style TargetType="Window"><Setter Property="Background" Value="{StaticResource Background}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
    <Style TargetType="Button"><Setter Property="Background" Value="#1C3321"/><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="14,10"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="BorderBrush" Value="#497252"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#0B140D"/><Setter Property="BorderBrush" Value="#4B6B51"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10"/><Setter Property="FontSize" Value="13"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D6E6D9"/><Setter Property="Margin" Value="0,6,16,6"/></Style>
    <Style TargetType="ListView"><Setter Property="Background" Value="#0B140D"/><Setter Property="Foreground" Value="#E9F3E9"/><Setter Property="BorderBrush" Value="#35543C"/></Style>
  </Application.Resources>
</Application>
