<Window x:Class="OTSSecuritySuite.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="OTS Security Suite · Ohana Tech Solutions" Icon="AppIcon.ico"
        Width="1280" Height="860" MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterScreen" Closing="OnWindowClosing" Loaded="OnWindowLoaded">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="96"/><RowDefinition Height="*"/><RowDefinition Height="35"/></Grid.RowDefinitions>
    <Border Background="#0B1510" BorderBrush="#28492F" BorderThickness="0,0,0,1" Grid.Row="0">
      <DockPanel Margin="24,12">
        <Image Source="OhanaLogo.png" Width="92" Height="69" Stretch="Uniform" DockPanel.Dock="Left" Margin="0,0,15,0"/>
        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
          <TextBlock Text="OTS SECURITY SUITE" FontSize="24" FontWeight="Bold" Foreground="#F2FFF0"/>
          <TextBlock Text="OHANA TECH SOLUTIONS · LOCAL SECURITY TOOLS" Foreground="#9BC5A3" FontSize="11" Margin="0,3,0,0"/>
        </StackPanel>
        <TextBlock Text="●  LOCAL-FIRST" Foreground="#39FF14" FontSize="13" FontWeight="Bold" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" BorderBrush="#28492F" BorderThickness="0,0,1,0" Background="#0F1811">
        <StackPanel Margin="14,24,8,12">
          <TextBlock Text="SECURITY MODULES" Foreground="#8CA692" FontSize="11" Margin="8,0,0,14"/>
          <Button Name="RepoTab" Click="ShowRepository" Content="▣  REPOSITORY SECURITY" Foreground="#39FF14"/>
          <Button Name="WhiteTab" Click="ShowWhite" Content="⌘  CODE &amp; SECRETS AUDIT"/>
          <Button Name="SystemTab" Click="ShowSystem" Content="▤  WINDOWS SECURITY"/>
          <Button Name="CleanupTab" Click="ShowCleanup" Content="⊞  QUARANTINE &amp; CLEANUP"/>
          <Border Background="#1C3020" CornerRadius="6" Margin="4,22,8,0" Padding="11">
            <TextBlock Text="SCAN READ-ONLY BY DEFAULT&#10;&#10;Review findings before quarantining or removing anything." Foreground="#B9D1BD" TextWrapping="Wrap" FontSize="12"/>
          </Border>
        </StackPanel>
      </Border>
      <Grid Grid.Column="1" Margin="18,16,18,10">
        <Grid Name="RepositoryPanel">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="REPOSITORY MALWARE SCANNER" Foreground="#39FF14" FontWeight="Bold" FontSize="13" Margin="2,0,0,12"/>
          <Border Grid.Row="1" Background="#0C140E" BorderBrush="#35543C" BorderThickness="1" CornerRadius="8">
            <Grid>
              <wv2:WebView2 Name="RepositoryBrowser" Visibility="Collapsed"/>
              <TextBlock Name="RepositoryLoading" Text="Starting local repository engine..." Foreground="#A9C4AF" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
            </Grid>
          </Border>
        </Grid>
        <Grid Name="WhitePanel" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="W.H.I.T.E. · CODE SECURITY AUDIT" Foreground="#39FF14" FontWeight="Bold" FontSize="18" Margin="0,0,0,14"/>
          <StackPanel Grid.Row="1">
            <TextBlock Text="LOCAL GIT REPOSITORY FOLDER" Foreground="#B5C9B8" Margin="0,0,0,6"/>
            <DockPanel><Button DockPanel.Dock="Right" Click="BrowseWhiteFolder" Content="BROWSE..."/><TextBox x:Name="WhiteFolder" Text="" Margin="0,0,8,8"/></DockPanel>
            <WrapPanel><CheckBox Name="HistoryScan" Content="Scan Git history"/><CheckBox Name="DependencyScan" Content="Dependency CVEs (requires OSV offline cache)"/></WrapPanel>
            <WrapPanel Margin="0,12,0,0"><Button Click="RunWhiteAudit" Name="WhiteRun" Content="RUN CODE SECURITY AUDIT ▶" Foreground="#39FF14"/><Button Click="CancelWhiteAudit" Name="WhiteCancel" Content="CANCEL AUDIT" IsEnabled="False"/><Button Click="ExportWhiteReport" Content="EXPORT REPORT"/></WrapPanel>
          </StackPanel>
          <TextBlock Grid.Row="2" x:Name="WhiteStatus" Text="Secrets · SAST · Git history · offline dependency audit" Foreground="#9AC4A3" Margin="0,10,0,12"/>
          <TextBox Grid.Row="3" Name="WhiteOutput" TextWrapping="Wrap" FontFamily="Consolas" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </Grid>
        <Grid Name="SystemPanel" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="WINDOWS THREAT &amp; PERSISTENCE INSPECTION" Foreground="#39FF14" FontWeight="Bold" FontSize="18" Margin="0,0,0,16"/>
          <WrapPanel Grid.Row="1"><Button Name="QuickButton" Click="RunQuick" Content="QUICK SCAN"/><Button Name="DeepButton" Click="RunDeep" Content="DEEP SCAN"/><Button Name="SystemCancel" Click="CancelSystemScan" Content="CANCEL SCAN" IsEnabled="False"/><Button Click="RunDefender" Content="REQUEST DEFENDER SCAN"/><Button Click="OpenSanitizer" Content="OPEN FULL SANITIZER"/></WrapPanel>
          <TextBlock Grid.Row="2" Name="SystemStatus" Foreground="#A9CCA9" Text="System inspection is read-only. Destructive actions require confirmation." Margin="0,14,0,12" TextWrapping="Wrap"/>
          <ListView Grid.Row="3" Name="SystemFindings" SelectionMode="Single" >
            <ListView.View><GridView><GridViewColumn Header="Severity" DisplayMemberBinding="{Binding Severity}" Width="90"/><GridViewColumn Header="Finding" DisplayMemberBinding="{Binding Title}" Width="220"/><GridViewColumn Header="Location" DisplayMemberBinding="{Binding Path}" Width="430"/></GridView></ListView.View>
          </ListView>
          <WrapPanel Grid.Row="4" Margin="0,12,0,0"><Button Click="InvestigateFinding" Content="INVESTIGATE SELECTED"/><Button Click="QuarantineFinding" Content="QUARANTINE SELECTED"/></WrapPanel>
        </Grid>
        <Grid Name="CleanupPanel" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="QUARANTINE VAULT &amp; SPACE RECOVERY" Foreground="#39FF14" FontWeight="Bold" FontSize="18" Margin="0,0,0,14"/>
          <WrapPanel Grid.Row="1"><Button Click="RefreshQuarantine" Content="REFRESH QUARANTINE"/><Button Click="InvestigateQuarantined" Content="REVIEW SELECTED"/><Button Click="RestoreQuarantined" Content="RESTORE SELECTED"/><Button Click="DestroyQuarantined" Content="DESTROY REVIEWED"/></WrapPanel>
          <ListView Grid.Row="2" Name="QuarantineItems"><ListView.View><GridView><GridViewColumn Header="Original path" DisplayMemberBinding="{Binding OriginalPath}" Width="570"/><GridViewColumn Header="Quarantined" DisplayMemberBinding="{Binding QuarantinedAt}" Width="195"/></GridView></ListView.View></ListView>
          <WrapPanel Grid.Row="3" Margin="0,14,0,4"><Button Click="DiscoverCleanup" Content="DISCOVER OLD TEMP FILES"/><Button Click="RemoveCleanup" Content="REMOVE CHECKED FILES"/><CheckBox Name="BrowserCache" Content="Include browser caches"/></WrapPanel>
          <TextBlock Grid.Row="4" Name="CleanupStatus" Foreground="#B2CBB5" Text="Review the candidate files before removing them." Margin="0,0,0,8"/>
          <ListView Grid.Row="5" Name="CleanupItems" SelectionMode="Extended"><ListView.View><GridView><GridViewColumn Header="File" DisplayMemberBinding="{Binding Path}" Width="530"/><GridViewColumn Header="Size" DisplayMemberBinding="{Binding SizeLabel}" Width="110"/><GridViewColumn Header="Category" DisplayMemberBinding="{Binding Category}" Width="150"/></GridView></ListView.View></ListView>
        </Grid>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="#0B1510" BorderBrush="#28492F" BorderThickness="0,1,0,0">
      <DockPanel Margin="20,7"><TextBlock Text="OTS SECURITY SUITE · PRE-RELEASE ENGINE INTEGRATION" Foreground="#88A18C" FontSize="11" DockPanel.Dock="Left"/><TextBlock Text="© OHANA TECH SOLUTIONS" Foreground="#88A18C" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="11"/></DockPanel>
    </Border>
  </Grid>
</Window>
